# Secrets — 永不進 git
.env

# 資料 — 永不進 git(Synthea 下載/生成/子集化產物;錨定根目錄,tests/data 等 fixture 不受影響)
/data/

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
build/
*.egg-info/

# Node(M4 前端)
node_modules/
app/dist/

# 內部工作文件 — 留在本機,不對外
# PLAN.md 是 milestone 追蹤、CLAUDE.md 是 AI 助理的工作約定、.claude/ 是編輯器與
# skill 設定。三者對讀者沒有意義,對開發仍然需要,所以是「不追蹤」而不是刪除。
# README 原本連到 .claude/skills/run-eval/SKILL.md,那份內容已搬到 docs/EVAL.md。
/PLAN.md
/CLAUDE.md
/.claude/

# 本地雜項
.DS_Store
Thumbs.db

# audit log(本地執行產物,不進 git)
/audit_log/

# 負載測試的暫存檔(run_loadtest.py 正常結束時會自己清掉;這行是被中斷時的保險。
# reports/loadtest/ 底下的報表本身要進 git)
/reports/loadtest/_*
