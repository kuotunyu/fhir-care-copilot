# Secrets — 永不進 git
.env

# 資料 — 永不進 git(Synthea 下載/生成/子集化產物;錨定根目錄,tests/data 等 fixture 不受影響)
/data/

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
build/
*.egg-info/

# Node(M4 前端)
node_modules/
app/dist/

# 內部工作文件與私人面試筆記 — 留在本機,不對外
/PLAN.md
/CLAUDE.md
/AGENTS.md
/.claude/
/docs/PROGRESS.md
/docs/superpowers/
interview*.md
INTERVIEW_PREP.md
*.private.md

# 本地雜項
.DS_Store
Thumbs.db

# audit log(本地執行產物,不進 git)
/audit_log/

# 負載測試的暫存檔(run_loadtest.py 正常結束時會自己清掉;這行是被中斷時的保險。
# reports/loadtest/ 底下的報表本身要進 git)
/reports/loadtest/_*
