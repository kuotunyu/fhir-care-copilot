# 複製為 .env 並填入金鑰;.env 已在 .gitignore,永不進 git。

# Google AI Studio 金鑰:https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 選配:備用金鑰(429 quota failover 用,可留空)
GEMINI_API_KEY_BACKUP=
GEMINI_API_KEY_BACKUP2=
GEMINI_API_KEY_BACKUP3=

# OpenAI 金鑰:https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Hugging Face token(僅 scripts/publish_to_hf.py 發布用)
HF_TOKEN=

# ---- runtime 設定(M3/M4 起生效,皆有預設值,不設也能跑) ----
# provider:mock | gemini | openai;沒設就用 configs/models.yaml 的 default_provider,
# 選到的 provider 缺對應金鑰時自動退回 mock(demo mode)
# FHIR_COPILOT_PROVIDER=mock

# LocalBundleFHIRStore 的資料目錄;預設 data/processed/subset_100
# FHIR_COPILOT_DATA_DIR=data/processed/subset_100

# propose_care_note 確認後寫入的本地 audit log 路徑;預設 audit_log/care_notes.jsonl
# FHIR_COPILOT_AUDIT_LOG_PATH=audit_log/care_notes.jsonl
